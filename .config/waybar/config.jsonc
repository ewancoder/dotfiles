{
  "id": "tyrbar",
  "ipc": true,
  "output": ["DP-3", "DP-1", "eDP-1", "HDMI-A-1", "HDMI-A-3"],
  "position": "top",
  "height": 56,
  "spacing": 0,
  "reload_style_on_change": true,

  "modes": {
    "overlay": { "layer": "top", "exclusive": false, "passthrough": false, "visible": true }
  },

  "modules-left":   ["sway/workspaces", "sway/mode", "custom/lyrics"],
  "modules-center": ["clock"],
  "modules-right":  ["custom/qbit", "custom/netstats", "cpu", "temperature", "memory", "network", "wireplumber", "tray"],

  "sway/workspaces": { "disable-scroll": true, "format": "{name}" },
  "sway/mode":       { "format": "-- {} --" },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "interval": 30
  },
  "cpu":    { "format": "cpu {usage}%", "interval": 2 },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "{temperatureC}°C",
    "interval": 2
  },
  "custom/netstats": { "exec": "cat /tmp/netstats", "interval": 5 },
  "custom/lyrics":   { "exec": "cat /tmp/lyrics", "interval": 1, "max-length": 80 },
  "custom/qbit": {
    "exec": "[ \"$(curl -s -m1 localhost:8080/api/v2/transfer/speedLimitsMode)\" = 1 ] && echo 🐢 || true",
    "interval": 5
  },
  "memory": { "format": "mem {percentage}%", "interval": 5 },
  "network": {
    "format-ethernet": "eth {ipaddr}",
    "format-wifi": "wlan {essid}",
    "format-disconnected": "net down",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}"
  },
  "wireplumber": {
    "format": "vol {volume}%",
    "format-muted": "vol --",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "tray": { "icon-size": 30, "spacing": 16, "show-passive-items": true }
}
