assign [app_id="^opentrack$"]               workspace 10:trash
assign [app_id="^xplane-map-enhancement$"]  workspace 10:trash
assign [class="^FfbBridge\.Desktop$"]       workspace 10:trash

assign [class="^Volanta$"]                   workspace 7:right-fun
assign [app_id="^Volanta$"]                  workspace 7:right-fun
assign [class="^xplane-map-enhancement$"]    workspace 7:right-fun
assign [app_id="^xplane-map-enhancement$"]   workspace 7:right-fun

exec steam -silent -nobootstrapupdate -skipinitialbootstrap -noverifyfiles

for_window [shell="xwayland" title="^Demo panel$"] move container to workspace xp-pfd, resize set 1340x800, move position 0 0
