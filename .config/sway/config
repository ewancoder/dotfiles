output HEADLESS-2 mode 1340x800@60Hz scale 1 pos 23000 0 bg #000000 solid_color
output HEADLESS-3 mode 1340x800@60Hz scale 1 pos 26000 0 bg #000000 solid_color
output HEADLESS-4 mode 3840x2160@120Hz scale 1 pos 28000 0 bg #000000 solid_color
workspace xp-pfd output HEADLESS-1 gaps horizontal 20
workspace xp-mfd output HEADLESS-2 gaps horizontal 20
workspace xp-aux output HEADLESS-3 gaps horizontal 20

workspace 4:fun output HEADLESS-4
workspace xp-park output HEADLESS-4
exec ~/.local/bin/xp-park
mouse_warping none

for_window [class="^X-Plane" title="^pilot-1000$"]  move container to workspace xp-pfd
for_window [class="^X-Plane" title="^center-1000$"] move container to workspace xp-mfd
