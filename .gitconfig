[user]
    name = Ivan Zyranau
    email = ewancoder@gmail.com
    signingkey = A57116EE67BF8798!
[core]
    editor = vim
[merge]
    tool = vimdiff
    conflictStyle = zdiff3
[rerere]
    enabled = true
[includeIf "gitdir:~/work/"]
    path = .gitconfig-work
[commit]
    gpgsign = true
[tag]
    gpgsign = true
[init]
    defaultBranch = main
[diff]
    external = difft
