#!/bin/sh
# Telegram on the AMD iGPU (Radeon 610M) to keep NVIDIA VRAM free (~270 MiB).
# Shadows /usr/bin/Telegram via PATH (~/.local/bin first): covers sway autostart,
# the .desktop launcher and t.me links. Remove this file to go back to NVIDIA.
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
export DRI_PRIME=pci-0000_7a_00_0
exec /usr/bin/Telegram "$@"
